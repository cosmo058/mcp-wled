# Copy to .env and adjust for your setup

# WLED device hostname or IP address
WLED_HOST=wled.local

# WLED HTTP port (default: 80)
WLED_PORT=80

# Matrix dimensions
MATRIX_WIDTH=16
MATRIX_HEIGHT=16

# Serpentine wiring: even rows L→R, odd rows R→L
# Set to false if all rows run in the same direction (confirmed working for this matrix)
MATRIX_SERPENTINE=false

# Default brightness (0–255)
DEFAULT_BRIGHTNESS=128
